{
  "manifest_version": 3,
  "name": "SmartPloy Apply Companion",
  "version": "0.6.0",
  "description": "Profile-once reviewed Lever/Ashby/Greenhouse form filling, exact CV and letter PDF attachment from your signed-in SmartPloy tab. Final send requires separate authorization.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "action": {
    "default_title": "SmartPloy · Job intelligence",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "host_permissions": [
    "https://smartploy.komplyint.fi/*"
  ]
}
