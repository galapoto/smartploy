{
  "manifest_version": 3,
  "name": "SmartPloy Apply Companion",
  "version": "0.5.2",
  "description": "Reviewed Lever, Ashby and hosted Greenhouse form/PDF help. Only individually approved Lever jobs permit one-use final click. No background sending.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "action": {
    "default_title": "SmartPloy Apply Companion",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
