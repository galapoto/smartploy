SMARTPLOY_HOST=127.0.0.1
SMARTPLOY_PORT=8090

# Leave blank for the in-memory development repository.
SMARTPLOY_DATABASE_URL=

# ObumAI reasoning integration. Leave blank to run without AI reasoning.
OBUMAI_BASE_URL=
OBUMAI_AGENT_ID=obum-assistant
OBUMAI_TIMEOUT_SECONDS=15
OBUMAI_HTTP_HEADERS_JSON={}

# Authorized Kuntarekry employer RSS/XML feed.
# Smartploy does not automate login and does not persist this feed URL in job evidence.
KUNTAREKRY_FEED_URL=
KUNTAREKRY_ALLOWED_HOSTS=kuntarekry.fi
KUNTAREKRY_TIMEOUT_SECONDS=15
KUNTAREKRY_MAX_BYTES=5242880
KUNTAREKRY_HTTP_HEADERS_JSON={}

# Safe draft-preparation workers. These create/refresh ObumAI text jobs only.
SMARTPLOY_PREPARE_BATCH_LIMIT=20
SMARTPLOY_REFRESH_BATCH_LIMIT=50
