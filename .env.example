SMARTPLOY_HOST=127.0.0.1
SMARTPLOY_PORT=8090

# Leave blank for the in-memory development repository.
SMARTPLOY_DATABASE_URL=

# ObumAI reasoning integration. Leave blank to run without AI reasoning.
OBUMAI_BASE_URL=
OBUMAI_AGENT_ID=obum-assistant
OBUMAI_TIMEOUT_SECONDS=15
OBUMAI_HTTP_HEADERS_JSON={}

# Authorized Kuntarekry employer RSS/XML feed.
# Smartploy does not automate login and does not persist this feed URL in job evidence.
KUNTAREKRY_FEED_URL=
KUNTAREKRY_ALLOWED_HOSTS=kuntarekry.fi
KUNTAREKRY_TIMEOUT_SECONDS=15
KUNTAREKRY_MAX_BYTES=5242880
KUNTAREKRY_HTTP_HEADERS_JSON={}

# Safe draft-preparation workers. These create/refresh ObumAI text jobs only.
SMARTPLOY_PREPARE_BATCH_LIMIT=20
SMARTPLOY_REFRESH_BATCH_LIMIT=50

# CRM backfill/synchronization batch.
SMARTPLOY_CRM_SYNC_LIMIT=500

# Job Market Finland / Tyomarkkinatori official P67 retrieval API.
# Keep disabled until your organisation has accepted KEHA terms and received credentials.
JOBMARKET_FINLAND_API_ENABLED=false
JOBMARKET_FINLAND_ENVIRONMENT=test
# Normally leave blank so Smartploy selects the exact official endpoint for the environment.
JOBMARKET_FINLAND_ENDPOINT=
JOBMARKET_FINLAND_KIPA_SUBSCRIPTION_KEY=
# Only for additional headers explicitly supplied by KEHA; protected P67 headers cannot be overridden.
JOBMARKET_FINLAND_HTTP_HEADERS_JSON={}
JOBMARKET_FINLAND_POSTING_LANGUAGES=fi,en,sv
JOBMARKET_FINLAND_TIMEOUT_SECONDS=20
JOBMARKET_FINLAND_MAX_BYTES=26214400
JOBMARKET_FINLAND_MAX_ITEMS=10000
JOBMARKET_FINLAND_INITIAL_LOOKBACK_MINUTES=120
JOBMARKET_FINLAND_OVERLAP_MINUTES=5

# Read-only public employer ATS sources (SmartRecruiters and Lever).
# Configure either inline JSON OR a local JSON file, not both.
SMARTPLOY_PUBLIC_ATS_SOURCES_JSON=
SMARTPLOY_PUBLIC_ATS_SOURCES_FILE=
SMARTPLOY_PUBLIC_ATS_TIMEOUT_SECONDS=15
SMARTPLOY_PUBLIC_ATS_PAGE_SIZE=100
SMARTPLOY_PUBLIC_ATS_MAX_ITEMS=10000
SMARTPLOY_PUBLIC_ATS_MAX_RESPONSE_BYTES=10485760
