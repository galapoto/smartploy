# Copy to deploy/personal/env on obum-core-01 and chmod 600.
# This file is intentionally not committed.
#
# Compose reads this file for interpolation, but API/worker containers receive only the
# explicitly allowlisted variables in docker-compose.yml. The file is NOT injected wholesale.

POSTGRES_DB=smartploy
POSTGRES_USER=smartploy
POSTGRES_PASSWORD=replace-with-url-safe-random-password

SMARTPLOY_WEB_HOST_PORT=8091
SMARTPLOY_PROFILE_ID=default

# Cloudflare Access application for smartploy.obumai.com. These go to API only.
SMARTPLOY_ACCESS_ISSUER=https://your-team.cloudflareaccess.com
SMARTPLOY_ACCESS_AUDIENCE=replace-with-smartploy-access-audience
SMARTPLOY_ACCESS_ALLOWED_EMAIL=replace-with-approved-owner-email

# FIRST-PARTY ZITADEL OIDC RELEASE (opt in only, never default).
# Keep issuer/provider configuration privately in deploy/personal/env.
# SMARTPLOY_PRODUCTION_IDENTITY_MODE=oidc is a HOST-ONLY selector in release commands,
# not a value in this env file. Cloudflare edge must allow / and /auth/* through.
SMARTPLOY_OIDC_ISSUER=https://auth.obumai.com
SMARTPLOY_OIDC_CLIENT_ID=replace-with-registered-public-oidc-client-id
SMARTPLOY_OIDC_REDIRECT_URI=https://smartploy.obumai.com/auth/callback
SMARTPLOY_OIDC_POST_LOGOUT_REDIRECT_URI=https://smartploy.obumai.com/auth/logged-out
SMARTPLOY_OIDC_SCOPE=openid profile email

# Employer-admin authorized PARTNER API only; configured individual jobs only.
# Never put API keys in Git, Cloudflare Pages, frontend code or worker.
# No default employer is authorized. Exact standard form, consent terms,
# independent two-person rights row and approved applicant required before POST.
SMARTPLOY_LEVER_PARTNER_JOBS_JSON=
SMARTPLOY_LEVER_PARTNER_KEY_PRIMARY=
SMARTPLOY_LEVER_PARTNER_KEY_SECONDARY=
SMARTPLOY_LEVER_PARTNER_KEY_TERTIARY=
# Optional explicit operator allowlist. Default blank denies shared HTTP writes
# to /api/v1/sources and /api/v1/jobs/ingest in authenticated deployments.
# Use the stable user_id returned by your own verified /api/v1/session;
# never enter an email, arbitrary role, subject, or a wildcard.
# The read-only source worker uses internal Python calls and is unaffected.
SMARTPLOY_OPERATOR_USER_IDS=

# ObumAI product-agent integration. API and worker may use these.
OBUMAI_BASE_URL=https://app.obumai.com
OBUMAI_AGENT_ID=obum-assistant
OBUMAI_TIMEOUT_SECONDS=15
OBUMAI_HTTP_HEADERS_JSON={}

# Optional local-only AI suggestions through an existing private ObumAI/Ollama model.
# No external AI forwarding, no automatic document replacement or employer submission.
# Confirm reachability from the API container before enabling.
SMARTPLOY_LOCAL_AI_ENABLED=false
SMARTPLOY_LOCAL_AI_BASE_URL=http://ollama:11434
SMARTPLOY_LOCAL_AI_MODEL=qwen3:4b
SMARTPLOY_LOCAL_AI_TIMEOUT_SECONDS=75

# Job Market Finland. These go to worker only.
JOBMARKET_FINLAND_API_ENABLED=false
JOBMARKET_FINLAND_ENVIRONMENT=test
JOBMARKET_FINLAND_ENDPOINT=
JOBMARKET_FINLAND_KIPA_SUBSCRIPTION_KEY=
JOBMARKET_FINLAND_HTTP_HEADERS_JSON={}
JOBMARKET_FINLAND_POSTING_LANGUAGES=fi,en,sv
JOBMARKET_FINLAND_TIMEOUT_SECONDS=20
JOBMARKET_FINLAND_MAX_BYTES=26214400
JOBMARKET_FINLAND_MAX_ITEMS=10000
JOBMARKET_FINLAND_INITIAL_LOOKBACK_MINUTES=120
JOBMARKET_FINLAND_OVERLAP_MINUTES=5

# Authorized Kuntarekry source. These go to worker only.
KUNTAREKRY_FEED_URL=
KUNTAREKRY_ALLOWED_HOSTS=kuntarekry.fi
KUNTAREKRY_TIMEOUT_SECONDS=15
KUNTAREKRY_MAX_BYTES=5242880
KUNTAREKRY_HTTP_HEADERS_JSON={}

# Read-only public ATS source pilot for NEW SmartPloy installations:
# Reuse the five reviewed Finland employer boards shipped in the image.
# The worker can fetch jobs on the first start, without employer credentials
# or transferring any applicant CV/profile data. If using a different approved
# registry, change this path or use the existing operator staging script.
# Existing private deploy/personal/env files are never overwritten.
SMARTPLOY_PUBLIC_ATS_SOURCES_JSON=
SMARTPLOY_PUBLIC_ATS_SOURCES_FILE=/workspace/config/finland_public_ats_pilot.json
SMARTPLOY_PUBLIC_ATS_TIMEOUT_SECONDS=15
SMARTPLOY_PUBLIC_ATS_PAGE_SIZE=100
SMARTPLOY_PUBLIC_ATS_MAX_ITEMS=10000
SMARTPLOY_PUBLIC_ATS_MAX_RESPONSE_BYTES=10485760

# Continuous worker policy.
SMARTPLOY_WORKER_LOOP_SECONDS=15
SMARTPLOY_WORKER_LEASE_SECONDS=900
SMARTPLOY_WORKER_MAX_BACKOFF_SECONDS=3600
SMARTPLOY_WORKER_CLAIM_LIMIT=8
SMARTPLOY_WORKER_OWNER=
SMARTPLOY_WORKER_JOBMARKET_CADENCE_SECONDS=300
SMARTPLOY_WORKER_KUNTAREKRY_CADENCE_SECONDS=600
SMARTPLOY_WORKER_PUBLIC_ATS_CADENCE_SECONDS=600
# Unattended processing of an operator profile in ObumAI is OFF by default.
# Do not enable in multi-user production without verifiable individual consent.
# Production **rejects** 'true' until per-account, revocable consent is wired.
# Legacy global auto-preparation can run only in explicit development/test
# environments and is not intended for real candidate data.
# 'false' leaves ATS polling and existing preparation-status refresh enabled.
SMARTPLOY_WORKER_AUTO_DRAFT_ENABLED=true
SMARTPLOY_WORKER_AUTO_DRAFT_CADENCE_SECONDS=600
SMARTPLOY_WORKER_AUTO_PREPARE_ENABLED=false
SMARTPLOY_WORKER_PREPARE_CADENCE_SECONDS=120
SMARTPLOY_WORKER_REFRESH_CADENCE_SECONDS=60
SMARTPLOY_PREPARE_BATCH_LIMIT=20
SMARTPLOY_REFRESH_BATCH_LIMIT=50

# Backup/deploy host paths. Host-side scripts read these; app containers do not.
SMARTPLOY_BACKUP_DIR=/srv/obum/backups/smartploy
SMARTPLOY_BACKUP_KEEP=7
SMARTPLOY_DEPLOY_STATE_DIR=/srv/obum/data/smartploy/deploy-state
