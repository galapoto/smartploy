# Copy to deploy/personal/env on obum-core-01 and chmod 600.
# This file is intentionally not committed.

POSTGRES_DB=smartploy
POSTGRES_USER=smartploy
POSTGRES_PASSWORD=replace-with-url-safe-random-password

SMARTPLOY_WEB_HOST_PORT=8091
SMARTPLOY_PROFILE_ID=default

# Cloudflare Access application for smartploy.obumai.com.
SMARTPLOY_ACCESS_ISSUER=https://your-team.cloudflareaccess.com
SMARTPLOY_ACCESS_AUDIENCE=replace-with-smartploy-access-audience
SMARTPLOY_ACCESS_ALLOWED_EMAIL=replace-with-approved-owner-email

# ObumAI product-agent integration. Prefer the protected production endpoint.
OBUMAI_BASE_URL=https://app.obumai.com
OBUMAI_AGENT_ID=obum-assistant
OBUMAI_TIMEOUT_SECONDS=15
# Example only; add reviewed machine-auth headers at deployment time.
OBUMAI_HTTP_HEADERS_JSON={}

# Job Market Finland remains disabled until KEHA onboarding and credentials are ready.
JOBMARKET_FINLAND_API_ENABLED=false
JOBMARKET_FINLAND_ENVIRONMENT=test
JOBMARKET_FINLAND_KIPA_SUBSCRIPTION_KEY=
JOBMARKET_FINLAND_HTTP_HEADERS_JSON={}

# Optional authorized source configuration.
KUNTAREKRY_FEED_URL=
KUNTAREKRY_HTTP_HEADERS_JSON={}
SMARTPLOY_PUBLIC_ATS_SOURCES_JSON=
SMARTPLOY_PUBLIC_ATS_SOURCES_FILE=

# Continuous worker policy.
SMARTPLOY_WORKER_LOOP_SECONDS=15
SMARTPLOY_WORKER_LEASE_SECONDS=900
SMARTPLOY_WORKER_MAX_BACKOFF_SECONDS=3600
SMARTPLOY_WORKER_CLAIM_LIMIT=8
SMARTPLOY_WORKER_JOBMARKET_CADENCE_SECONDS=300
SMARTPLOY_WORKER_KUNTAREKRY_CADENCE_SECONDS=600
SMARTPLOY_WORKER_PUBLIC_ATS_CADENCE_SECONDS=600
SMARTPLOY_WORKER_PREPARE_CADENCE_SECONDS=120
SMARTPLOY_WORKER_REFRESH_CADENCE_SECONDS=60

# Backup/deploy host paths.
SMARTPLOY_BACKUP_DIR=/srv/obum/backups/smartploy
SMARTPLOY_BACKUP_KEEP=7
SMARTPLOY_DEPLOY_STATE_DIR=/srv/obum/data/smartploy/deploy-state
