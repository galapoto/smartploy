:8080 {
    encode zstd gzip

    header {
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
        Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; connect-src 'self'; img-src 'self' data:; font-src 'self' data:; base-uri 'none'; frame-ancestors 'none'; form-action 'self'"
    }

    @backend path /api/* /auth/* /healthz
    handle @backend {
        reverse_proxy api:8090 {
            # Preserve the original Host header for TrustedHostMiddleware:
            # Cloudflare legacy and Komplyint first-party OIDC have separate
            # exact-host policies. Never force the legacy host on the new app.
            header_up X-Forwarded-Proto https
            header_up Cf-Access-Jwt-Assertion {http.request.header.Cf-Access-Jwt-Assertion}
        }
    }

    # A real, immutable-build marker must be served as JSON without SPA
    # fallback or caching. Independent HTTPS/API parity is tested before
    # a trusted deployment may record the approved SHA.
    @release path /release.json
    handle @release {
        header Cache-Control "no-store"
        root * /srv
        file_server
    }

    # Do not let the SPA fallback pretend a missing/outdated extension ZIP
    # exists: direct download must return a real ZIP or a genuine HTTP 404.
    @companion path /smartploy-apply-companion.zip /smartploy-apply-companion.zip.sha256
    handle @companion {
        header Cache-Control "no-store"
        root * /srv
        file_server
    }

    # Vite content-hashed PUBLIC assets only. Private/auth/release routes
    # retain their independent policies; the HTML shell always revalidates.
    @immutable path_regexp immutable ^/assets/[^/]+-[A-Za-z0-9_-]{8,}\.(js|css|woff2?|svg|png|jpg|webp)$
    handle @immutable {
        root * /srv
        header Cache-Control "public, max-age=31536000, immutable"
        file_server
    }

    handle {
        root * /srv
        header Cache-Control "no-cache"
        try_files {path} /index.html
        file_server
    }
}
