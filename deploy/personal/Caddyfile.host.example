# Add this block to the existing OVH HTTPS ingress ONLY after confirming
# it uses Caddy. Do not replace other virtual hosts, especially
# auth.komplyint.fi. This example is not automatically deployed.
# Public DNS is verified: smartploy.komplyint.fi -> 51.75.61.214.
# Caddy must obtain a public certificate using its existing 80/443 route.
# SmartPloy's container web port remains loopback-only on 127.0.0.1:8091.
smartploy.komplyint.fi {
    reverse_proxy 127.0.0.1:8091
}
