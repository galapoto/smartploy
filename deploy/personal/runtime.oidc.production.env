# Opt-in user-facing production identity policy. No secrets or account IDs.
# Select explicitly with SMARTPLOY_PRODUCTION_IDENTITY_MODE=oidc.
# Do NOT select until ZITADEL client permits smartploy.komplyint.fi callbacks,
# DNS/TLS, Cloudflare edge Access bypass for THIS host, preflight
# and rollback are verified. The former CF Access profile is retained.

SMARTPLOY_ENVIRONMENT=production
SMARTPLOY_HOST=0.0.0.0
SMARTPLOY_PORT=8090
SMARTPLOY_PUBLIC_ORIGIN=https://smartploy.komplyint.fi
SMARTPLOY_ALLOWED_HOSTS=smartploy.komplyint.fi
SMARTPLOY_AUTH_MODE=oidc
SMARTPLOY_ACCESS_ENABLED=false
